# Copia este archivo a ".env" para desarrollo local (NUNCA subir .env a Git).
# En Vercel: pega estas variables en Settings → Environment Variables.

PORT=3001
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/oncodetect
JWT_SECRET=elige_una_frase_larga_y_secreta
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD_HASH=$2b$10$...hash_de_bcrypt...
ADMIN_PASSWORD_HASH=$2b$10$...hash_de_bcrypt...
GMAIL_USER=micorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Opcional: si prefieres Resend en lugar de Gmail (más confiable desde la nube)
#RESEND_API_KEY=re_xxxxxxxx